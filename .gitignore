# NexTrace - Git Ignore

# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build files
build/
dist/
*.egg-info/
.eggs/

# Test / coverage cache
.pytest_cache/
.coverage
htmlcov/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# NexTrace generated output
reports/
output/